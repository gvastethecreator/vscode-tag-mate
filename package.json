{
  "name": "tag-mate",
  "displayName": "Tag Mate",
  "description": "Change, match, wrap, and remove paired markup tags.",
  "version": "0.0.1",
  "packageManager": "pnpm@12.1.0",
  "publisher": "gvastethecreator",
  "author": {
    "name": "gvastethecreator"
  },
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/vscode-tag-mate.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/vscode-tag-mate/issues"
  },
  "homepage": "https://github.com/gvastethecreator/vscode-tag-mate#readme",
  "keywords": [
    "html",
    "xml",
    "jsx",
    "tsx",
    "tags"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "tagMate.changeTag",
        "title": "Change Tag",
        "category": "Tag Mate"
      },
      {
        "command": "tagMate.goToMatchingTag",
        "title": "Go to Matching Tag",
        "category": "Tag Mate"
      },
      {
        "command": "tagMate.selectTagPair",
        "title": "Select Tag Pair",
        "category": "Tag Mate"
      },
      {
        "command": "tagMate.removeSurroundingTag",
        "title": "Remove Surrounding Tag",
        "category": "Tag Mate"
      },
      {
        "command": "tagMate.wrapSelection",
        "title": "Wrap Selection with Tag",
        "category": "Tag Mate"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.cjs",
    "watch": "node esbuild.cjs --watch",
    "package": "tsc --noEmit && node esbuild.cjs --production",
    "vsix": "pnpm run package && vsce package --no-dependencies",
    "check-types": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
